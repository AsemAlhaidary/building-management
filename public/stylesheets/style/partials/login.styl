.formContainer {
  width: 100%;
  height: 100vh;
  display: grid;
  place-items: center;

  .formBox {
    padding: var(--boxPadding);
    max-width: 60%;
    max-height: 80%;
    display: flex;
    gap: calc(var(--boxPadding) / 2);
    flex-direction: column;
    align-items: center;
    border-radius: 10px;
    background-color:  var(--accentColor);

    .title {
      color: var(--themeColor);
    }

    inputForm();

    .row {
      gap: 0.5em !important;
      flex-direction: column !important;
      align-items: flex-start !important;
    }
  }
}