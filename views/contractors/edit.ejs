<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'contractors', projectId: projectId }) %>
    <div class="workspace">
      <div class="formBox">
        <h3 class="title">Edit contractor</h3>
        <form action="/contractors/<%= projectId %>/edit/<%= contractor.id %>" method="POST" class="form grid">
          <div class="row">
            <% if (label) { %>
              <label class="def" for="contractorName">Name</label>
            <% } %>
            <input type="text" id="contractorName" class="input" name="nContractorName" value="<%= contractor.contractor_name %>" placeholder="Name" required>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="contractorDetails">Details</label>
            <% } %>
            <input type="text" id="contractorDetails" class="input" name="nContractorDetails" value="<%= contractor.contractor_work_details %>" placeholder="Details" required>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="contractorWorkUnit">Unit</label>
            <% } %>
            <select id="contractorWorkUnit" class="input" name="nContractorWorkUnit" size="1">
              <% workTypes.forEach(workType => { %>
                <option value="<%= workType %>" <% if (contractor.contractor_work_unit == workType) { %>
                  selected
                <% } %>><%= workType %></option>
              <% }) %>
            </select>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="contractorWorkQuantity">Quantity</label>
            <% } %>
            <input type="number" id="contractorWorkQuantity" class="input" name="nContractorWorkQuantity" value="<%= contractor.contractor_work_quantity %>" placeholder="Quantity">
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="contractorUnitPrice">Price</label>
            <% } %>
            <input type="number" id="contractorUnitPrice" class="input" name="nContractorUnitPrice" value="<%= contractor.contractor_unit_price %>" placeholder="Price">
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="contractorWorkTotal">Total</label>
            <% } %>
            <input type="number" id="contractorWorkTotal" class="input" name="nContractorWorkTotal" value="<%= contractor.contractor_work_total %>" placeholder="Total">
          </div>
          <div class="actionButtons">
            <button type="submit">Add</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>