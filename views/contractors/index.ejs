<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'contractors', projectId: projectId }) %>
    <div class="workspace index">
      <div class="info">
        <% contractors.forEach((contractor) => { %>
          <span class="infoContainer">
            <div class="infos">
              <h3 class="data name">Name: <span class="value"><%= contractor.contractor_name %></span></h3>
              <h3 class="data job">Details: <span class="value"><%= contractor.contractor_work_details %></span></h3>
              <h3 class="data phoneNum">Total Price: <span class="value"><%= contractor.contractor_work_total %></span></h3>
            </div>
            <div class="buttons">
              <form action="/contractors/<%= projectId %>/delete/<%= contractor.id %>" method="POST">
                <button type="submit">Delete</button>
              </form>
              <form action="/contractors/<%= projectId %>/edit/<%= contractor.id %>" method="GET">
                <button type="submit">Edit</button>
              </form>
              <form action="/contractors/<%= projectId %>/info/<%= contractor.id %>" method="GET">
                <button type="submit">Info</button>
              </form>
            </div>
          </span>
        <% }) %>
      </div>
      <div class="actionButtons">
        <form action="/contractors/<%= projectId %>/new" method="GET">
          <button type="submit">New</button>
        </form>
      </div>
    </div>
  </div>
</div>