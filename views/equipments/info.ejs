<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'equipments', projectId: projectId }) %>
    <div class="workspace">
      <div class="infoBox">
        <h3 class="title">Info <%= equipment.equipment_name %></h3>
        <div class="field">
          <h3 class="info">Name: <span><%= equipment.equipment_name %></span></h3>
        </div>
        <div class="field">
          <h3 class="info">Date: <span><%= equipment.equipment_date %></span></h3>
        </div>
        <div class="field">
          <h3 class="info">Unit Price: <span><%= equipment.equipment_unit_price %></span></h3>
        </div>
        <div class="field">
          <h3 class="info">Quantity: <span><%= equipment.equipment_unit_quantity %></span></h3>
        </div>
        
        <div class="field">
          <h3 class="info">Total Price: <span><%= equipment.equipment_total %></span></h3>
        </div>
        <div class="field">
          <h3 class="info">Details: <span><%= equipment.equipment_details %></span></h3>
        </div>
        <div class="actionButtons">
          <form action="/equipments/<%= projectId %>/report/<%= equipment.id %>" method="post">
            <button type="submit">Report</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>