<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'equipments' , projectId: projectId }) %>
    <div class="workspace">
      <div class="formBox">
        <h3 class="title">New equipments</h3>
        <form action="/equipments/<%= projectId %>/create" method="POST" class="form grid">
          <div class="row">
            <% if (label) { %>
              <label class="def" for="name">Name</label>
            <% } %>
            <input type="text" id="name" class="input" name="equipmentName" placeholder="Name">
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="date">Date</label>
            <% } %>
            <input type="date" id="date" class="input" name="equipmentDate" placeholder="Date">
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="unitPrice">Unit Price</label>
            <% } %>
            <input type="number" id="unitPrice" class="input" name="equipmentUnitPrice" placeholder="Unit Price">
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="quantity">Quantity</label>
            <% } %>
            <input type="number" id="quantity" class="input" name="equipmentUnitQuantity" placeholder="Quantity">
          </div>
          <div class="row spanTwo">
            <% if (label) { %>
              <label class="def" for="details">Details</label>
            <% } %>
            <textarea name="equipmentDetails" class="input" id="details" cols="30" rows="10" placeholder="Details"></textarea>
          </div>
          <div class="actionButtons">
            <button type="submit">Add</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>