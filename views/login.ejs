<div class="formContainer">
  <div class="formBox">
    <h1 class="title">Log in</h1>
    <form class="form" action="/login" method="POST">
      <div class="row">
        <% if (label) { %>
          <label class="def" for="username">Username</label>
        <% } %>
        <input type="email" id="username" class="input" name="username" placeholder="Username" required>
      </div>
      <div class="row">
        <% if (label) { %>
          <label class="def" for="password">Password</label>
        <% } %>
        <input type="password" id="password" class="input" name="password" placeholder="Password" required>
      </div>
      <p class="error">
        <% if (messages.error) { %>
          <%- messages.error %>
        <% } %>
      </p>
      <button class="button" type="submit">Log in</button>
      <% if (allowSign) { %>
        <a class="link" href="/signin">Sign in</a>
      <% } %>
    </form>
  </div>
</div>