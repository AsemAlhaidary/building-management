<div class="container">
  <div class="formBox">
    <h1 class="title">Log in</h1>
    <form action="/login" method="POST">
      <label for="name">Name:</label>
      <input type="text" id="name" class="input" name="name" placeholder="ex...'Ahmed'" required>
      <label for="password">Password:</label>
      <input type="password" id="password" class="input" name="password" placeholder="ex...'426443'" required>
      <% if (messages.error) { %>
        <p class="error"><%- messages.error %></p>
      <% } %>
      <button type="submit">Log in</button>
      <a href="/signin">Sign in</a>
    </form>
  </div>
</div>