<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'paymentsrecives', projectId: projectId }) %>
    <div class="workspace">
      <div class="formBox">
        <h3 class="title">paymentsrecive</h3>
        <form action="/paymentsrecives/<%= projectId %>/create" method="POST" class="form">
          <div class="row">
            <% if (label) { %>
              <label class="def" for="paymentsrecive">Paymentsrecive</label>
            <% } %>
            <select id="paymentsrecive" class="input" name="paymentsreciveId" size="1">
              <% paymentsrecives.forEach(paymentsrecive => { %>
                <option value="<%= paymentsrecive.id %>"><%= paymentsrecive.payments_amount %></option>
              <% }) %>
            </select>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="date">Date</label>
            <% } %>
            <input type="number" id="date" class="input" name="paymentsdate " placeholder="paymentsdate " required>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="paymentsdetails">Payments_details</label>
            <% } %>
           
          </div>
          <div class="actionButtons">
            <button type="submit">Add</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>