<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'extras', projectId: projectId }) %>
    <div class="workspace">
      <div class="formBox">
        <h3 class="title">Edit Extra</h3>
        <form action="/extras/<%= projectId %>/edit/<%= extra.id %>" method="POST" class="form">
          <div class="row">
            <% if (label) { %>
              <label class="def" for="employee">Employee</label>
            <% } %>
            <select id="employee" class="input" name="employeeId" size="1">
              <% employees.forEach(employee => { %>
                <option value="<%= employee.id %>" <% if (employee.id == extra.employee_id) { %>
                  selected
                <% } %>><%= employee.employee_name %></option>
              <% }) %>
            </select>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="time">Time</label>
            <% } %>
            <input type="number" id="time" class="input" name="nExtraTime" value="<%= extra.extra_time %>" placeholder="Extra Time" required>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="extraTimePrice">Time Price</label>
            <% } %>
            <input type="number" id="extraTimePrice" class="input" name="nExtraTimePrice" value="<%= extra.extra_time_price%>" placeholder="Time Price" required>
          </div>
          <div class="actionButtons">
            <button type="submit">Edit</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>