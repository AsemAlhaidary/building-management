<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'paymentsservice', projectId: projectId }) %>
    <div class="workspace">
      <div class="infoBox">
        <h3 class="title">Info Payment Service</h3>
        <div class="field">
          <h3 class="info">Amount: <span><%= paymentService.payments_amount %></span></h3>
        </div>
        <div class="field">
          <h3 class="info">Date: <span><%= paymentService.payments_date %></span></h3>
        </div>
        <div class="field">
          <h3 class="info">Details: <span><%= paymentService.payments_details %></span></h3>
        </div>
        <div class="actionButtons">
          <form action="/extras/<%= projectId %>/report/<%= paymentService.id %>" method="post">
            <button type="submit">Report</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>