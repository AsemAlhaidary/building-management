<div class="formContainer">
  <div class="formBox">
    <h1 class="title">Sign in</h1>
    <form class="form" action="/signin/addUser" method="POST">
      <div class="row">
        <% if (label) { %>
          <label class="def" for="name">Name</label>
        <% } %>
        <input type="text" id="name" class="input" name="name" placeholder="Name" required>
      </div>
      <div class="row">
        <% if (label) { %>
          <label class="def" for="username">Username</label>
        <% } %>
        <input type="email" id="username" class="input" name="username" placeholder="user@name" required>
      </div>
      <div class="row">
        <% if (label) { %>
          <label class="def" for="password">Password</label>
        <% } %>
        <input type="password" id="password" class="input" name="password" placeholder="Password" required>
      </div>
      <p class="error">
        <% if (messages.error) { %>
          <%= messages.error %>
        <% } %>
      </p>
      <button class="button" type="submit">Sign in</button>
      <a class="link" href="/login">Log in</a>
    </form>
  </div>
</div>