<div class="container">
  <%- include('../partials/navbar') %>
  <%- include('../partials/sidebar') %>
  <div class="workspace">
    <form action="/employees/new" method="POST" class="addForm">
      <div class="field">
        <label class="def" for="name">Name</label>
        <input type="text" id="name" class="input" name="name" placeholder="Ahmad" required>
      </div>
      <div class="field">
        <label class="def" for="job">Job</label>
        <select name="job" id="job">
          <option selected label="Job" value="Job">
          <option label="Job 1" value="Job 1">
          <option label="Job 2" value="Job 2">
        </select>
      </div>
      <div class="field">
        <label class="def" for="phone">Phone</label>
        <input type="tel" id="phone" class="input" name="phone" placeholder="32-6-2022" required>
      </div>
      <div class="actionButtons">
        <button type="submit">Additional</button>
      </div>
    </form>
  </div>
</div>