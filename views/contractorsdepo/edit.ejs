<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'contractorsdepo', projectId: projectId }) %>
    <div class="workspace">
      <div class="formBox">
        <h3 class="title">Edit Deposit</h3>
        <form action="/contractorsdepo/<%= projectId %>/edit/<%= contractorDeposit.id %>" method="POST" class="form grid">
          <div class="row">
            <% if (label) { %>
              <label class="def" for="contractor">Contractor</label>
            <% } %>
            <select id="contractor" class="input" name="contractorId" size="1">
              <% contractors.forEach(contractor => { %>
                <option value="<%= contractor.id %>" <% if (contractor.id == contractorDeposit.contractor_id) { %>
                  selected
                <% } %>>
                  <%= contractor.contractor_name %>
                </option>
              <% }) %>
            </select>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="method">Method</label>
            <% } %>
            <select id="method" class="input" name="depositMethod" size="1">
              <% methods.forEach(method => { %>
                <option value="<%= method %>" <% if (contractorDeposit.deposit_method == method) { %>
                  selected
                <% } %>>
                  <%= method %>
                </option>
              <% }) %>
            </select>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="depositDate">Date</label>
            <% } %>
            <input type="date" id="depositDate" class="input" name="depositDate" placeholder="Date" value="<%= contractorDeposit.deposit_date %>" required>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="depositPrice">Price</label>
            <% } %>
            <input type="number" id="depositPrice" class="input" name="depositPrice" placeholder="Price" min="0" value="<%= contractorDeposit.deposit_price %>" required>
          </div>
          <p class="error">
            <% if (messages.error) { %>
              <%- messages.error %>
            <% } %>
          </p>
          <div class="actionButtons">
            <button type="submit">Edit</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>