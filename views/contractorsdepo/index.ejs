<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'contractorsdepo', projectId: projectId }) %>
    <div class="workspace index">
      <div class="info">
        <% contractorsDeposits.forEach((contractorDeposit) => { %>
          <span class="infoContainer">
            <div class="infos">
              <h3 class="data name">Name: <span class="value"><%= contractorDeposit.contractor_name %></span></h3>
              <h3 class="data Time">Date of Deposit: <span class="value"><%= contractorDeposit.deposit_date %></span></h3>
              <h3 class="data type">Type of Deposit: <span class="value"><%= contractorDeposit.deposit_method %></span></h3>
              <h3 class="data phoneNum">Price of Deposit: <span class="value"><%= contractorDeposit.deposit_price %></span></h3>
            </div>
            <div class="buttons">
              <form action="/contractorsdepo/<%= projectId %>/delete/<%= contractorDeposit.id %>" method="POST">
                <button type="submit">Delete</button>
              </form>
              <form action="/contractorsdepo/<%= projectId %>/edit/<%= contractorDeposit.id %>" method="GET">
                <button type="submit">Edit</button>
              </form>
              <form action="/contractorsdepo/<%= projectId %>/info/<%= contractorDeposit.id %>" method="GET">
                <button type="submit">Info</button>
              </form>
            </div>
          </span>
        <% }) %>
      </div>
      <div class="actionButtons">
        <form action="/contractorsdepo/<%= projectId %>/new" method="GET">
          <button type="submit">New</button>
        </form>
      </div>
    </div>
  </div>
</div>