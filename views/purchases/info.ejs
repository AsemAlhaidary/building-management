<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'purchases', projectId: projectId }) %>
    <div class="workspace">
      <div class="infoBox">
        <h3 class="title">Info <%= purchase.purchase_name %></h3>
        <div class="field">
          <h3 class="info">Name: <span><%= purchase.purchase_name %></span></h3>
        </div>
        <div class="field">
          <h3 class="info">Unit: <span><%= purchase.purchase_unit %></span></h3>
        </div>
        <div class="field">
          <h3 class="info">Unit Price: <span><%= purchase.purchase_unit_price %></span></h3>
        </div>
        <div class="field">
          <h3 class="info">Quantity: <span><%= purchase.purchase_unit_quantity %></span></h3>
        </div>
        <div class="field">
          <h3 class="info">Type: <span><%= purchase.purchase_type %></span></h3>
        </div>
        <div class="field">
          <h3 class="info">Total Price: <span><%= purchase.purchase_total %></span></h3>
        </div>
        <div class="field">
          <h3 class="info">Details: <span><%= purchase.purchase_details %></span></h3>
        </div>
        <div class="actionButtons">
          <form action="/purchases/<%= projectId %>/report/<%= purchase.id %>" method="post">
            <button type="submit">Report</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>