<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'purchases', projectId: projectId }) %>
    <div class="workspace index">
      <div class="info">
        <% purchases.forEach((purchase) => { %>
          <span class="infoContainer">
            <div class="infos">
              <h3 class="data name">Name: <span class="value"><%= purchase.purchase_name %></span></h3>
              <h3 class="data price">Unit Price: <span class="value"><%= purchase.purchase_unit_price %></span></h3>
              <h3 class="data quantity">Unit Quantity: <span class="value"><%= purchase.purchase_unit_quantity %></span></h3>
              <h3 class="data total">Total Price: <span class="value"><%= purchase.purchase_total %></span></h3>
            </div>
            <div class="buttons">
              <form action="/purchases/<%= projectId %>/delete/<%= purchase.id %>" method="POST">
                <button type="submit">Delete</button>
              </form>
              <form action="/purchases/<%= projectId %>/edit/<%= purchase.id %>" method="GET">
                <button type="submit">Edit</button>
              </form>
              <form action="/purchases/<%= projectId %>/info/<%= purchase.id %>" method="GET">
                <button type="submit">Info</button>
              </form>
            </div>
          </span>
        <% }) %>
      </div>
      <div class="actionButtons">
        <form action="/purchases/<%= projectId %>/new" method="GET">
          <button type="submit">New</button>
        </form>
      </div>
    </div>
  </div>
</div>