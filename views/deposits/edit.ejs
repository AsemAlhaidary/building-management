<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'deposits', projectId: projectId }) %>
    <div class="workspace">
      <div class="formBox">
        <h3 class="title">تعديل صرف/ قبض عامل جديد</h3>
        <form action="/deposits/<%= projectId %>/edit/<%= deposit.id %>" method="POST" class="form">
          <div class="row">
            <label class="def" for="name">Name</label>
            <input type="text" id="name" class="input" name="depositaName" value="<%= deposit.deposit_name %>" placeholder="First Last" required>
          </div>
          <div class="row">
            <label class="def" for="time">Time</label>
            <input type="text" id="time" class="input" name="depositTime" value="<%= deposit.deposit_time %>" placeholder="التاريخ" required>
          </div>
          <div class="row">
            <label class="def" for="">Time Price</label>
            <input type="tel" id="deposit_time_price" class="input" name="depositstimeprice" value="<%= deposit.deposit_time_price%>" placeholder="" required>
          </div>
          <div class="actionButtons">
            <button type="submit">تعديل</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>