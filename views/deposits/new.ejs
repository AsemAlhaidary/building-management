<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'deposits', projectId: projectId }) %>
    <div class="workspace">
      <div class="formBox">
        <h3 class="title">New Deposit</h3>
        <form action="/deposits/<%= projectId %>/create" method="POST" class="form">
          <div class="row">
            <% if (label) { %>
              <label class="def" for="employee">Employee</label>
            <% } %>
            <select id="employee" class="input" name="employeeId" size="1">
              <% employees.forEach(employee => { %>
                <option value="<%= employee.id %>"><%= employee.employee_name %></option>
              <% }) %>
            </select>
           
          </div>
          
          <div class="row">
            <label class="def" for="time">Deposit Unit</label>
            <input type="text" id="time" class="input" name="depositTime" placeholder="Deposit time" required>
          </div>
          <div class="row">
            <label class="def" for="deposit_price ">deposit_price </label>
            <input type="tel" id="deposit_price " class="input" name="depositprice " placeholder="777777777" required>
          </div>
          <div class="actionButtons">
            <button type="submit">Add</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>