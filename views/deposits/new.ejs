<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'deposits' , projectId: projectId }) %>
    <div class="workspace">
      <div class="formBox">
        <h3 class="title">صرف/قبض عامل جديد</h3>
        <form action="/deposits/<%= projectId %>/create" method="POST" class="form grid">
          <div class="row">
            <% if (label) { %>
              <label class="def" for="employee">Employee</label>
            <% } %>
            <select id="employee" class="input" name="employeeId" size="1">
              <% employees.forEach(employee => { %>
                <option value="<%= employee.id %>">
                  <%= employee.employee_name %>
                </option>
              <% }) %>
            </select>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="method">Method</label>
            <% } %>
            <select id="method" class="input" name="depositMethod" size="1">
              <% methods.forEach(method => { %>
                <option value="<%= method %>">
                  <%= method %>
                </option>
              <% }) %>
            </select>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="depositDate">Date</label>
            <% } %>
            <input type="date" id="depositDate" class="input" name="depositDate" placeholder="التاريخ" required>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="depositPrice">Price</label>
            <% } %>
            <input type="number" id="depositPrice" class="input" name="depositPrice" placeholder="السعر" min="0" required>
          </div>
          <p class="error">
            <% if (messages.error) { %>
              <%- messages.error %>
            <% } %>
          </p>
          <div class="actionButtons">
            <button type="submit">اضافة</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>