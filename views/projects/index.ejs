<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <div class="workspace">
      <div class="info">
        <% projects.forEach((project) => { %>
          <span class="infoContainer">
            <div class="infos">
              <h3 class="data name">Name: <span class="value"><%= project.project_name %></span></h3>
              <h3 class="data address">Address: <span class="value"><%= project.project_address %></span></h3>
              <h3 class="data start">Start Date: <span class="value"><%= project.project_start_date %></span></h3>
              <h3 class="data end">End Date: <span class="value"><%= project.project_end_date %></span></h3>
            </div>
            <div class="buttons">
              <form action="/projects/delete/<%= project.id %>" method="POST">
                <button type="submit">Delete</button>
              </form>
              <form action="/projects/edit/<%= project.id %>" method="GET">
                <button type="submit">Edit</button>
              </form>
              <form action="/projects/open/<%= project.id %>" method="POST">
                <button type="submit">Open</button>
              </form>
            </div>
          </span>
        <% }) %>
      </div>
      <div class="actionButtons">
        <form action="/projects/new" method="GET">
          <button type="submit">New</button>
        </form>
      </div>
    </div>
  </div>
</div>