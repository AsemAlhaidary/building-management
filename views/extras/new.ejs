<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar') %>
    <div class="workspace">
      <div class="formBox">
        <h3 class="title">New Extra</h3>
        <form action="/extras/<%= projectId %>/create" method="POST" class="form">
          <div class="row">
            <label class="def" for="name">Name</label>
            <input type="text" id="name" class="input" name="extraName" placeholder="First Last" required>
          </div>
          <div class="row">
            <label class="def" for="time">Job</label>
            <input type="text" id="time" class="input" name="extraTime" placeholder="extra_time" required>
          </div>
          <div class="row">
            <label class="def" for="extra_time_price ">extra_time_price </label>
            <input type="tel" id="extra_time_price " class="input" name="extratimeprice " placeholder="777777777" required>
          </div>
          <div class="actionButtons">
            <button type="submit">Add</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>