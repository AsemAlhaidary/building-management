<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'extras', projectId: projectId }) %>
    <div class="workspace">
      <div class="formBox">
        <h3 class="title">اضافيات العمال</h3>
        <form action="/extras/<%= projectId %>/create" method="POST" class="form">
          <div class="row">
            <% if (label) { %>
              <label class="def" for="employee">Employee</label>
            <% } %>
            <select id="employee" class="input" name="employeeId" size="1">
              <% employees.forEach(employee => { %>
                <option value="<%= employee.id %>"><%= employee.employee_name %></option>
              <% }) %>
            </select>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="time">Time</label>
            <% } %>
            <input type="number" id="time" class="input" name="extraTime" placeholder="وقت الاضافي" required>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="extraTimePrice">Time Price</label>
            <% } %>
            <input type="number" id="extraTimePrice" class="input" name="extraTimePrice" placeholder="سعر الساعة" required>
          </div>
          <div class="actionButtons">
            <button type="submit">اضافة</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>