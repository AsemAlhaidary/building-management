<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'extras', projectId: projectId }) %>
    <div class="workspace">
      <div class="infoBox">
        <h3 class="title">Info <%= extra.extra_name %></h3>
        <div class="field">
          <h3 class="info">Name: <span><%= extra.extra_name %></span></h3>
        </div>
        <div class="field">
          <h3 class="info">Time: <span><%=extra .extra_time %></span></h3>
        </div>
        <div class="field">
          <h3 class="info">Time Price: <span><%= extra.extra_time_price %></span></h3>
        </div>
        <div class="actionButtons">
          <form action="/extras/<%= projectId %>/report/<%= extra.id %>" method="post">
            <button type="submit">Report</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>