<div class="container">
  <%- include('../partials/navbar') %>
  <div class="workspaceContainer">
    <%- include('../partials/sidebar', { active: 'employees', projectId: projectId }) %>
    <div class="workspace">
      <div class="formBox">
        <h3 class="title">تعديل عامل </h3>
        <form action="/employees/<%= projectId %>/edit/<%= employee.id %>" method="POST" class="form grid">
          <div class="row">
            <% if (label) { %>
              <label class="def" for="name">Name</label>
            <% } %>
            <input type="text" id="name" class="input" name="employeeName" value="<%= employee.employee_name %>" placeholder="الاسم" required>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="job">Job</label>
            <% } %>
            <input type="text" id="job" class="input" name="employeeJob" value="<%= employee.employee_job %>" placeholder="المهنة" required>
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="phoneNum">Phone Number</label>
            <% } %>
            <input type="tel" id="phoneNum" class="input" name="employeePhoneNum" value="<%= employee.employee_phone_num %>" placeholder="رقم تلفونة" >
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="dayPrice">Day Price</label>
            <% } %>
            <input type="number" id="dayPrice" class="input" name="employeeDayPrice" value="<%= employee.employee_day_price %>" placeholder="سعر يومة">
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="workStart">Work Start</label>
            <% } %>
            <input type="date" id="workStart" class="input" name="employeeWorkStart" value="<%= employee.employee_start_date %>" placeholder="بداية عملة">
          </div>
          <div class="row">
            <% if (label) { %>
              <label class="def" for="workEnd">Work End</label>
            <% } %>
            <input type="date" id="workEnd" class="input" name="employeeWorkEnd" value="<%= employee.employee_start_date %>" placeholder="نهاية عملة">
          </div>
          <div class="actionButtons">
            <button type="submit">التعديل</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>